# Copy to a local .env file; never commit the real value.
# Materialize the Channel database password file with: scripts/deploy/write-channel-db-password-file.ps1

# Channel database
CHANNEL_DB_PASSWORD=replace-with-a-local-random-secret

# Core Fineract
POSTGRES_PASSWORD=replace-with-a-local-random-secret
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=replace-with-local-api-password
FINERACT_ADMIN_USERNAME=mifos
FINERACT_ADMIN_PASSWORD=replace-with-a-local-random-secret
FINERACT_DB_PASS=replace-with-a-local-random-secret
FINERACT_BASE_URL=http://fineract-server:8080/fineract-provider
FINERACT_TENANT=default

# Message broker (independent from database credentials)
ACTIVEMQ_PASSWORD=replace-with-a-local-random-secret

# Keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-random-secret

# Clearing
CLEARING_CALLBACK_SECRET=replace-with-a-local-random-secret

# Grafana
GRAFANA_ADMIN_USERNAME=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-random-secret

# Keycloak issuer URIs (v4 target ports)
BANK_CUSTOMER_ISSUER_URI=http://127.0.0.1:19000/realms/bank-customer
BANK_CUSTOMER_JWK_SET_URI=http://keycloak:8080/realms/bank-customer/protocol/openid-connect/certs
BANK_INTERNAL_ISSUER_URI=http://127.0.0.1:19000/realms/bank-internal
BANK_INTERNAL_JWK_SET_URI=http://keycloak:8080/realms/bank-internal/protocol/openid-connect/certs

# Required BYOK OpenAI-compatible model binding
HENGZHUN_MODEL_NAME=
HENGZHUN_MODEL_BASE_URL=
HENGZHUN_MODEL_API_KEY=
