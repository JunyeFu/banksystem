# Local core database backups and restore artefacts are never committed.
backups/

# Machine-local deployment secrets. Generate with scripts/deploy/generate-secrets.ps1.
.env
.env.*.local
**/.env
**/.env.*.local
secrets/
!secrets/.gitkeep

# Docker database volumes and local runtime output are machine-specific.
data/
logs/
*.log

# Dependency caches and local build output are reproducible artifacts.
**/node_modules/
**/dist/
**/target/
*.tsbuildinfo
