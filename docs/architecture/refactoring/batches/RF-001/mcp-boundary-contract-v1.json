{
  "schemaVersion": "rf001-mcp-boundary-contract-v1",
  "contractId": "RF-001-B2-MCP-33",
  "status": "CONTRACT_APPROVED",
  "approvedAt": "2026-08-02",
  "implementationAuthorized": true,
  "implementationPhase": "RF-001-B3_SHADOW_ONLY",
  "activeRuntimeContract": "platform/hengzhun-regression-system/contracts/mcp/hengzhun-i8.json",
  "toolCount": 33,
  "ownership": {
    "mcp": [
      "authenticate transport requests",
      "accept explicitly listed legacy wire forms",
      "normalize aliases into canonical request fields",
      "derive transport idempotency keys where declared",
      "project canonical safe errors and bounded responses"
    ],
    "harness": [
      "validate canonical business requests",
      "own authorization, state transitions and durable idempotency",
      "own domain error codes and data",
      "reject aliases that bypass the MCP boundary"
    ]
  },
  "canonicalErrorEnvelope": {
    "fields": [
      "errorCode",
      "category",
      "status",
      "retryable",
      "userActionRequired",
      "safeMessage",
      "fieldErrors",
      "correlationRef"
    ],
    "required": [
      "errorCode",
      "category",
      "status",
      "retryable",
      "userActionRequired"
    ],
    "legacyReadAliases": {
      "code": "errorCode",
      "message": "safeMessage",
      "validationIssues": "fieldErrors",
      "requestId": "correlationRef"
    },
    "forbidden": [
      "stack",
      "authorization",
      "apiKey",
      "token",
      "password",
      "credentialValue",
      "requestBody"
    ],
    "projectionRule": "Harness message may become safeMessage only after redaction; details may become fieldErrors only when field-scoped and non-sensitive."
  },
  "globalCompatibility": [
    {
      "id": "COMPAT-JSON-OBJECT-STRING",
      "acceptedAt": "MCP_ONLY",
      "rule": "An explicitly listed object field may accept a JSON object string and emit only the parsed canonical object.",
      "retirementGate": "Flowise consumer search, compatibility tests, shadow equivalence and rollback mapping"
    },
    {
      "id": "COMPAT-JSON-ARRAY-STRING",
      "acceptedAt": "MCP_ONLY",
      "rule": "An explicitly listed array field may accept a JSON array string and emit only the parsed canonical array.",
      "retirementGate": "Flowise consumer search, compatibility tests, shadow equivalence and rollback mapping"
    },
    {
      "id": "COMPAT-EMPTY-TO-UNDEFINED",
      "acceptedAt": "MCP_ONLY",
      "rule": "Only optional fields explicitly listed by a tool may map an empty string to omission.",
      "retirementGate": "No active Flowise producer sends empty placeholders"
    },
    {
      "id": "COMPAT-UNRESOLVED-TEMPLATE-OMIT",
      "acceptedAt": "MCP_ONLY",
      "rule": "Only journey_prepare may omit a value matching the narrow unresolved Flowise output-template pattern; all other templates fail closed.",
      "retirementGate": "The deployed Agentflow has no unresolved output templates in LIVE_E2E evidence"
    },
    {
      "id": "COMPAT-INTEGER-STRING",
      "acceptedAt": "MCP_ONLY",
      "rule": "Only explicitly listed integer fields may accept base-10 integer text; Harness receives an integer.",
      "retirementGate": "All active platform producers preserve numeric types"
    }
  ],
  "responseModes": {
    "PASS_THROUGH": "A bounded Harness domain response with no semantic alias generation.",
    "COMPACT_JOURNEY": "A bounded journey projection; MCP is the sole owner of Flowise root aliases after B3.",
    "COMPOSITE": "A documented orchestration of multiple Harness reads/writes that returns one bounded canonical result."
  },
  "sideEffects": {
    "READ_ONLY": "No durable state mutation.",
    "MUTATING": "Creates or changes durable state.",
    "CONDITIONAL_MUTATION": "May mutate depending on an explicit canonical request field or recovery state."
  },
