ney / Case / Run" parent="desired" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fontSize=13;fillColor=#e9f0fa;strokeColor=#416a9f;"><mxGeometry x="40" y="420" width="140" height="60" as="geometry"/></mxCell><mxCell id="desired-evidence" value="Harness 状态权威&#xa;SQLite / Evidence" parent="desired" vertex="1" style="shape=cylinder3;html=1;whiteSpace=wrap;fontSize=13;fillColor=#e9f0fa;strokeColor=#416a9f;"><mxGeometry x="220" y="420" width="140" height="60" as="geometry"/></mxCell><mxCell id="desired-quality" value="Quality 只读视图&#xa;不拥有执行状态" parent="desired" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fontSize=13;fillColor=#e6f2ef;strokeColor=#207267;"><mxGeometry x="400" y="420" width="140" height="60" as="geometry"/></mxCell><mxCell id="desired-note" value="核心事实 → 业务结果 → 测试核验&#xa;申请≠贷款；受理≠入账&#xa;渠道投影≠核心 GL" parent="desired" vertex="1" style="text;align=left;html=1;whiteSpace=wrap;fontSize=16;fillColor=none;strokeColor=none;"><mxGeometry x="40" y="555" width="670" height="75" as="geometry"/></mxCell><mxCell id="actual" value="AS-IS｜边界已有，部分语义未闭合" parent="1" vertex="1" style="swimlane;startSize=36;container=1;pointerEvents=0;html=1;whiteSpace=wrap;fontSize=13;fillColor=#f5f7fa;strokeColor=#8793a6;"><mxGeometry x="820" y="110" width="760" height="635" as="geometry"/></mxCell><mxCell id="actual-iam" value="身份上下文&#xa;Keycloak 身份 / 角色" parent="actual" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fontSize=13;fillColor=#e9f0fa;strokeColor=#416a9f;"><mxGeometry x="40" y="60" width="140" height="60" as="geometry"/></mxCell><mxCell id="actual-core" value="核心银行上下文&#xa;客户 / 账户 / 贷款" parent="actual" vertex="1" style="shape=cylinder3;html=1;whiteSpace=wrap;fontSize=13;fillColor=#e9f0fa;strokeColor=#416a9f;"><mxGeometry x="400" y="60" width="140" height="60" as="geometry"/></mxCell><mxCell id="actual-channel" value="渠道业务上下文&#xa;订单 / 申请 / 复核" parent="actual" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;fontSize=13;fillColor=#fff1d5;strokeColor=#b47b16;"><mxGeom