工作台&#10;目标、历史、模型配置" vertex="1" parent="1" style="shape=component;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#eaf1fa;strokeColor=#406894;"><mxGeometry as="geometry" x="30" y="150" width="260" height="90" /></mxCell><mxCell id="controller" value="Agent Controller&#10;目标与受约束Journey" vertex="1" parent="1" style="shape=component;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#eaf1fa;strokeColor=#406894;"><mxGeometry as="geometry" x="350" y="150" width="260" height="90" /></mxCell><mxCell id="mcp" value="独立MCP&#10;工具 / 会话 / 元数据合同" vertex="1" parent="1" style="shape=component;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#eaf1fa;strokeColor=#406894;"><mxGeometry as="geometry" x="710" y="150" width="260" height="90" /></mxCell><mxCell id="harness" value="Harness&#10;领取、验证、SQLite写入" vertex="1" parent="1" style="shape=component;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#e6f2ef;strokeColor=#267368;"><mxGeometry as="geometry" x="1100" y="150" width="260" height="90" /></mxCell><mxCell id="model" value="BYOK模型&#10;作者化与受控视觉协议" vertex="1" parent="1" style="shape=component;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#f4f6f9;strokeColor=#7d8ca0;"><mxGeometry as="geometry" x="350" y="400" width="260" height="90" /></mxCell><mxCell id="worker" value="Worker&#10;Playwright / Midscene" vertex="1" parent="1" style="shape=component;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#eaf1fa;strokeColor=#406894;"><mxGeometry as="geometry" x="1100" y="400" width="260" height="90" /></mxCell><mxCell id="bank-ui" value="银行页面&#10;实际目标与业务结果" vertex="1" parent="1" style="shape=component;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#f4f6f9;strokeColor=#7d8ca0;"><mxGeometry as="geometry" x="1100" y="650" width="260" height="90" /></mxCell><mxCell id="state" value="Harness SQLite + Evidence&#10;会话、Run、反馈与判定" vertex="1" parent="1" style="shape=cylinder3;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#e6f2ef;strokeColor=#267368;"><mxGeometry as="geometry" x="710" y="650" width="260" height="90" /></mxCell><mxCell id="quality" value="Quality只读投影&#10;无创作/批准控制面" vertex="1" parent="1" style="shape=component;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#eaf1fa;strokeColor=#406894;"><mxGeometry as="geometry" x="350" y="650" width="260" height="90" /></mxCell><mxCell id="keys" value="本地密钥登记&#10;仅引用，不进入模型" vertex="1" parent="1" style="shape=component;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#f4f6f9;strokeColor=#7d8ca0;"><mxGeometry as="geometry" x="30" y="400" width="260" height="90" /></mxCell><mxCell id="e-0" source="entry" target="controller" value="请求" edge="1" parent="1" style="html=1;fontSize=13;fontFamily=Microsoft YaHei;strokeColor=#66788d;fontColor=#34485e;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e-1" source="controller" target="mcp" value="受控工具" edge="1" parent="1" style="html=1;fontSize=13;fontFamily=Microsoft YaHei;strokeColor=#66788d;fontColor=#34485e;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e-2" source="mcp" target="harness" value="认证接口" edge="1" parent="1" style="html=1;fontSize=13;fontFamily=Microsoft YaHei;strokeColor=#66788d;fontColor=#34485e;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e-3" source="controller" target="model" value="作者化" edge="1" parent="1" style="html=1;fontSize=13;fontFamily=Microsoft YaHei;strokeColor=#66788d;fontColor=#34485e;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e-4" source="harness" target="worker" value="执行作业" edge="1" parent="1" style="html=1;fontSize=13;fontFamily=Microsoft YaHei;strokeColor=#66788d;fontColor=#34485e;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e-5" source="worker" target="model" value="视觉定位" edge="1" parent="1" style="html=1;fontSize=13;fontFamily=Microsoft YaHei;strokeColor=#66788d;fontColor=#34485e;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e-6" source="worker" target="bank-ui" value="浏览器" edge="1" parent="1" style="html=1;fontSize=13;fontFamily=Microsoft YaHei;strokeColor=#66788d;fontColor=#34485e;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e-7" source="harness" target="state" value="状态/证据" edge="1" parent="1" style="html=1;fontSize=13;fontFamily=Microsoft YaHei;strokeColor=#66788d;fontColor=#34485e;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e-8" source="quality" target="state" value="只读" edge="1" parent="1" style="html=1;fontSize=13;fontFamily=Microsoft YaHei;strokeColor=#66788d;fontColor=#34485e;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e-9" source="entry" target="keys" value="登记引用" edge="1" parent="1" style="html=1;fontSize=13;fontFamily=Microsoft YaHei;strokeColor=#66788d;fontColor=#34485e;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="view-title" value="UML组件｜Agent控制、执行与投影" vertex="1" parent="1" style="text;align=left;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#f4f6f9;strokeColor=#7d8ca0;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="30" y="10" width="1540" height="45" /></mxCell><mxCell id="view-subtitle" value="Harness拥有共享执行与会话状态；本地密钥/恢复辅助文件不是第二个任务真相源" vertex="1" parent="1" style="text;align=left;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#f4f6f9;strokeColor=#7d8ca0;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="30" y="65" width="1540" height="50" /></mxCell><mxCell id="view-note" value="工具活动摘要不是隐藏思维链。普通历史读取不重派任务；Flowise/仓库docs-RAG均不进入产品运行链。" vertex="1" parent="1" style="text;align=left;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#fff2da;strokeColor=#a97722;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="30" y="815" width="1540" height="65" /></mxCell></root></mxGraphModel></diagram><diagram id="05-transfer-sequence" name="转账时序｜提交权、核心调用与回读">
