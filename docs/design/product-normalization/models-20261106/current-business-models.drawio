          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      <mxCell id="view-title" value="转账时序｜提交权、核心调用与回读" vertex="1" parent="1" style="text;align=left;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#f4f6f9;strokeColor=#7d8ca0;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="30" y="10" width="1440" height="45" /></mxCell><mxCell id="view-subtitle" value="应用逻辑时序；省略认证握手/投影细节。每个TX独立提交，不跨网络持有本地事务" vertex="1" parent="1" style="text;align=left;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#f4f6f9;strokeColor=#7d8ca0;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="30" y="65" width="1440" height="50" /></mxCell><mxCell id="view-note" value="无领取权、5xx或网络故障不盲重发POST；明确4xx也先核原操作。页面超时但核心成功时，业务成功与测试失败可同时成立。" vertex="1" parent="1" style="text;align=left;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#fff2da;strokeColor=#a97722;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="30" y="935" width="1440" height="65" /></mxCell></root>
