<diagram id="07-state-boundaries" name="状态图｜业务状态不等于测试结论"><mxGraphModel adaptiveColors="auto" page="1" pageWidth="1600" pageHeight="930"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="pending" value="PENDING_CORE_POSTING&#10;尚未领取核心提交" vertex="1" parent="1" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#eaf1fa;strokeColor=#406894;"><mxGeometry as="geometry" x="50" y="180" width="260" height="90" /></mxCell><mxCell id="claimed" value="PENDING_CLEARING&#10;已领取，核心结果待核" vertex="1" parent="1" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#eaf1fa;strokeColor=#406894;"><mxGeometry as="geometry" x="500" y="180" width="260" height="90" /></mxCell><mxCell id="settled" value="SETTLED&#10;核心事实已核验" vertex="1" parent="1" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#e6f2ef;strokeColor=#267368;"><mxGeometry as="geometry" x="1000" y="180" width="260" height="90" /></mxCell><mxCell id="unknown" value="CORE_RESULT_UNKNOWN&#10;保留原键，只回读" vertex="1" parent="1" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#fff2da;strokeColor=#a97722;"><mxGeometry as="geometry" x="500" y="420" width="260" height="90" /></mxCell><mxCell id="failed" value="FAILED&#10;明确拒绝且回读未成功" vertex="1" parent="1" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#f4f6f9;strokeColor=#7d8ca0;"><mxGeometry as="geometry" x="50" y="420" width="260" height="90" /></mxCell><mxCell id="draft" value="DRAFT&#10;文档当前版本" vertex="1" parent="1" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#23364e;fillColor=#eaf1fa;strokeColor=#406894;"><mxGeometry as="geometry" x="50" y="670" width="260" height="90" /></mxCell><mxC