{
  "realm": "bank-customer",
  "displayName": "复兴银行客户统一身份认证",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "internationalizationEnabled": true,
  "defaultLocale": "zh-CN",
  "supportedLocales": ["zh-CN"],
  "loginTheme": "fuxing-bank",
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {"name": "CUSTOMER", "description": "复兴银行门户基础客户角色"},
      {"name": "CUSTOMER_MFA_VERIFIED", "description": "已完成增强身份验证的客户角色"},
      {"name": "CUSTOMER_BLOCKED", "description": "已阻断的客户角色"}
    ]
  },
  "defaultRoles": ["CUSTOMER"],
  "sslRequired": "external",
  "clients": [
    {
      "clientId": "customer-portal",
      "name": "Bank Customer Portal",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://127.0.0.1:18443/*", "http://127.0.0.1:18082/*"],
      "webOrigins": ["http://127.0.0.1:18443", "http://127.0.0.1:18082"],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "protocolMappers": [{
        "name": "bank-channel-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "config": {"included.custom.audience": "bank-channel-service", "access.token.claim": "true", "id.token.claim": "false"}
      }]
    },
    {
      "clientId": "bank-golden-path",
      "name": "Synthetic Banking Golden Path",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [{
        "name": "bank-channel-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "config": {"included.custom.audience": "bank-channel-service", "access.token.claim": "true", "id.token.claim": "false"}
      }]
    }
  ]
}
