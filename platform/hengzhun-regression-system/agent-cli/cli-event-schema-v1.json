{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hengzhun-cli-event/v1",
  "title": "Hengzhun CLI JSONL event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sequence", "type"],
  "properties": {
    "schemaVersion": { "const": "hengzhun-cli-event/v1" },
    "sequence": { "type": "integer", "minimum": 1 },
    "type": {
      "enum": ["STARTED", "ATTACHMENT_IMPORTED", "RESPONSE", "CLARIFICATION_REQUIRED", "APPROVAL_REQUIRED", "COMMAND_RESULT", "ERROR", "CANCELLED"]
    },
    "command": { "type": "string", "pattern": "^[a-z][a-z.-]{0,63}$" },
    "status": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "sessionId": { "type": "string", "minLength": 8, "maxLength": 160 },
    "journeyId": { "type": "string", "minLength": 8, "maxLength": 160 },
    "attachmentRef": { "type": "string", "minLength": 8, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "size": { "type": "integer", "minimum": 0, "maximum": 20971520 },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalId", "contentHash", "risk", "expiresAt", "summary"],
      "properties": {
        "proposalId": { "type": "string", "minLength": 8, "maxLength": 160 },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "risk": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "text": { "type": "string", "maxLength": 20000 },
    "messageCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,95}$" },
    "result": { "type": ["object", "array", "string", "number", "boolean", "null"] }
  }
}
