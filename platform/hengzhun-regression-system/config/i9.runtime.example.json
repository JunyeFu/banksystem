{
  "schemaVersion": "hengzhun-i9-runtime-v1",
  "network": {
    "host": "127.0.0.1",
    "flowisePort": 3006,
    "harnessPort": 18788,
    "mcpPort": 18789
  },
  "paths": {
    "nodeExecutable": "runtime/node-v20.20.2-win-x64/node.exe",
    "flowiseApp": "flowise/app",
    "flowiseData": ".data/flowise",
    "harnessDatabase": ".data/sqlite/regression_platform.sqlite",
    "artifactRoot": ".data/artifacts",
    "chromiumExecutable": "runtime/browsers/chromium-1217/chrome-win64/chrome.exe"
  },
  "credentialVariables": {
    "mcpToken": "HENGZHUN_MCP_TOKEN",
    "workerToken": "HENGZHUN_WORKER_TOKEN",
    "mimoApiKey": "MIMO_API_KEY"
  },
  "lifecycle": {
    "startupTimeoutSeconds": 90,
    "workerHeartbeatMaxAgeSeconds": 30
  }
}
