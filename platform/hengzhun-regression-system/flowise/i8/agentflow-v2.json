      "data": {"id":"llmAgentflow_structure","label":"结构化案例与验收摘要","name":"llmAgentflow","version":1.1,"type":"LLM","baseClasses":["LLM"],"category":"Agent Flows","inputs":{"llmModel":"chatOpenAI","llmMessages":[{"role":"system","content":"你是衡准主控。用户只提供案例描述。只依据输入和已发布知识生成严格JSON字符串，不生成定位器、Playwright源码、路径、SQL、Shell、端口、凭据或幂等参数。draftJson必须符合i8-regression-case-draft-v1，acceptanceSummaryJson必须符合i8-acceptance-summary-v1。只有角色不明确、期望互斥或高风险业务写入时clarificationRequired=true，并且只给一个业务问题。"},{"role":"user","content":"案例描述：{{$flow.input}}\n知识：{{retrieverAgentflow_i8.output}}"}],"llmEnableMemory":false,"llmReturnResponseAs":"userMessage","llmStructuredOutput":[{"key":"draftJson","type":"string","description":"严格RegressionCaseDraft JSON"},{"key":"acceptanceSummaryJson","type":"string","description":"严格AcceptanceSummary JSON"},{"key":"clarificationRequired","type":"boolean","description":"是否需要最小业务澄清"},{"key":"clarificationQuestion","type":"string","description":"至多一个业务澄清问题"}],"llmUpdateState":[],"llmModelConfig":{"modelName":"mimo-v2.5","temperature":0,"streaming":false,"maxTokens":32768,"basepath":"{{$vars.MIMO_BASE_URL}}","strictToolCalling":true,"llmModel":"chatOpenAI"}}}
