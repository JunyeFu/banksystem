{
  "schemaVersion": "hengzhun-i9-p4-controller-profile-v1",
  "platform": "FLOWISE",
  "provider": "MiMo",
  "adapter": "@langchain/openai ChatOpenAI from bundled Flowise runtime",
  "modelName": "mimo-v2.5",
  "baseUrl": "https://api.xiaomimimo.com/v1",
  "apiKeyVariable": "MIMO_API_KEY",
  "responseFormat": "json_object",
  "controllerContext": {
    "totalTokens": 1000000,
    "maximumInputTokens": 967232,
    "reservedOutputTokens": 32768
  },
  "visualContext": {
    "totalTokens": 16384,
    "maximumInputTokens": 12288,
    "reservedOutputTokens": 4096
  },
  "mcp": {
    "url": "http://127.0.0.1:18789/mcp",
    "tokenVariable": "HENGZHUN_MCP_TOKEN",
    "toolCount": 14,
    "harnessTimeoutMs": 30000,
    "maximumResponseBytes": 16384
  },
  "humanInput": {
    "requiredBeforeWrite": true,
    "requiredBeforeActivation": true,
    "requiredBeforeScheduling": true
  },
  "loopLimits": {
    "clarification": 2,
    "repairCandidates": 3,
    "polling": 40
  },
  "allowedNodeSemantics": [
    "chat_input",
    "knowledge_retrieval",
    "structured_llm",
    "condition",
    "loop",
    "human_input",
    "mcp_tool",
    "direct_reply"
  ],
  "forbiddenExternalCapabilities": [
    "code",
    "http",
    "database",
    "file",
    "shell",
    "browser",
    "arbitrary_url"
  ]
}
